# Multi-stage build of the aegisd API. modernc.org/sqlite is pure Go, so the
# binary builds static with CGO disabled and runs on distroless.
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/aegisd ./cmd/aegisd

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/aegisd /aegisd
EXPOSE 8080
ENV AEGIS_ADDR=0.0.0.0:8080 \
    AEGIS_DB=/data/aegis.db
VOLUME /data
ENTRYPOINT ["/aegisd"]
